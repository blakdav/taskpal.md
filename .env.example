# Copy to .env and fill in. .env is gitignored.

# Transcription. Get a key at platform.openai.com (separate from ChatGPT).
OPENAI_API_KEY=sk-...

# Swap these two to move transcription onto your own GPU. The request shape
# is identical, so nothing else changes:
#   TRANSCRIBE_URL=http://speaches:8000/v1/audio/transcriptions
#   TRANSCRIBE_MODEL=Systran/faster-whisper-large-v3
TRANSCRIBE_URL=https://api.openai.com/v1/audio/transcriptions
TRANSCRIBE_MODEL=gpt-4o-transcribe

# Words the recogniser reliably mangles. Comma-separated.
TRANSCRIBE_HINT=

# Leave empty behind WireGuard. Set a long random string if you expose this
# through NPM -- write routes then require: Authorization: Bearer <token>
TASKPAL_TOKEN=
